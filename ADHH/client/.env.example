# Local development only (Vite proxies /api -> the backend server)
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://localhost:8000

# Vercel production: leave VITE_API_BASE_URL unset, or use one of:
# VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=https://backend-wbrl.onrender.com/api
#
# Never set localhost in Vercel env vars.
