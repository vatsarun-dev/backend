PORT=8000
NODE_ENV=development
MONGO_URL=mongodb://0.0.0.0/amardeep
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth
GOOGLE_CLIENT=your-google-client-id
GOOGLE_SECRET=your-google-client-secret
# Local optional. In production, server uses CLIENT_URL + /api/user/google/callback.
# For Vercel frontend deployment, set Google Console Authorized redirect URI to:
# https://your-vercel-domain.vercel.app/api/user/google/callback
GOOGLE_CALLBACK=http://localhost:5173/api/user/google/callback

ACCESSTOKEN=your-access-token-secret
REFRESHTOKEN=your-refresh-token-secret
RAWTOKEN=your-password-reset-token-secret

URLENDPOINT=your-imagekit-url-endpoint
PRIVATEKEY=your-imagekit-private-key
PUBLICKEY=your-imagekit-public-key

EMAIL=your-email@example.com
PASSWORD=your-email-app-password
